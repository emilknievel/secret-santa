# Podman Quadlet unit: runs the site as a systemd service.
# Assumes the repo is cloned to ~/secret-santa. Install (rootless):
#   mkdir -p ~/.config/containers/systemd
#   cp ~/secret-santa/deploy/secret-santa.container ~/.config/containers/systemd/
#   systemctl --user daemon-reload && systemctl --user start secret-santa
#   loginctl enable-linger "$USER"   # keep it running after logout and reboot

[Unit]
Description=Hemliga tomten (secret santa site)

[Container]
Image=docker.io/library/caddy:2-alpine
# Localhost only: reachable by cloudflared on this host, not from the internet.
PublishPort=127.0.0.1:8080:8080
Volume=%h/secret-santa/public:/srv:ro
Volume=%h/secret-santa/deploy:/etc/caddy:ro

[Service]
Restart=always

[Install]
WantedBy=default.target

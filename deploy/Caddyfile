# Plain HTTP inside Docker; Cloudflare terminates TLS in front of the tunnel.
:8080 {
	root * /srv
	encode gzip
	file_server

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Robots-Tag noindex
	}

	# The page and data.js change on every draw, so Cloudflare must not cache
	# them, or old links break. The font never changes.
	@fresh not path /fonts/*
	header @fresh Cache-Control "no-cache"
	header /fonts/* Cache-Control "public, max-age=31536000, immutable"
}
